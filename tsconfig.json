{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",

    "allowJs": true,
    "checkJs": false,

    "strict": true,
    "skipLibCheck": true,

    "noEmit": true
  },
  "include": ["**/*.ts", "**/*.cjs", "routes/tasks.ts"],
  "exclude": ["node_modules", "dist", "public", "migrations", "seeds"]
}
